# Phase 1 — no env vars required (GitHub API is called client-side, no token needed)

# Phase 2 — uncomment when adding Go backend
# GITHUB_TOKEN=ghp_your_token_here   # optional: raises rate limit to 5000/hr

# Phase 3 — uncomment when adding database
# DB_PASSWORD=changeme
# DB_HOST=db
# DB_PORT=5432
# DB_NAME=portfolio
# DB_USER=portfolio
